{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAMEX source configuration",
  "type": "object",
  "required": ["sources"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["camera_id", "uri", "width", "height", "fps"],
        "properties": {
          "camera_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
          "uri": {"type": "string", "minLength": 1, "pattern": "^[^\\t\\r\\n]+$"},
          "width": {"type": "integer", "minimum": 2, "multipleOf": 2},
          "height": {"type": "integer", "minimum": 2, "multipleOf": 2},
          "fps": {"type": "number", "exclusiveMinimum": 0},
          "is_upscaled": {"type": "boolean"}
        }
      }
    }
  }
}
